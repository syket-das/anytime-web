{
  "compilerOptions": {
    "target": "es5", // Ensure compatibility with older browsers
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ], // Ensure compatibility with modern JavaScript and DOM APIs
    "allowJs": true, // Allows JavaScript files in the project
    "skipLibCheck": true, // Skip type-checking for declaration files for faster builds
    "strict": true, // Enable all strict type-checking options
    "forceConsistentCasingInFileNames": true, // Enforces consistent file naming (case-sensitive)
    "noEmit": true, // Prevent emitting JS files (since Next.js handles this)
    "esModuleInterop": true, // Ensure proper interop with CommonJS modules
    "module": "esnext", // Use ES modules
    "moduleResolution": "node", // Resolve modules in the same way Node.js does
    "resolveJsonModule": true, // Enable importing JSON files as modules
    "isolatedModules": true, // Helps with Next.js and React’s TypeScript handling
    "jsx": "preserve", // Use React's new JSX Transform (works well with Next.js)
    "incremental": true, // Enable incremental compilation (helps with large codebases)
    "plugins": [
      {
        "name": "next" // Integrates TypeScript with Next.js
      }
    ],
    "baseUrl": ".", // Set base URL for relative imports
    "paths": {
      "@/*": [
        "./src/*"
      ] // Simplify imports for `src` directory
    }
  },
  "include": [
    "next-env.d.ts", // Include Next.js environment type declarations
    "**/*.ts", // Include TypeScript files
    "**/*.tsx", // Include TypeScript JSX files
    ".next/types/**/*.ts", // Include type files generated by Next.js
    "tailwind.config.ts" // Include Tailwind config for TypeScript type-checking
  ],
  "exclude": [
    "node_modules" // Exclude the node_modules directory from compilation
  ]
}
